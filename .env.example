# Copie para .env e ajuste. O .env NÃO deve ir para o controle de versão.

# --- Aplicação ---
APP_ENV=development

# --- PostgreSQL local (instalação nativa) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=acompanhamento_semanal
# Usuário da aplicação (criado pelo scripts/init_db.py, dono do database)
POSTGRES_USER=acompanhamento_app
POSTGRES_PASSWORD=acompanhamento_app
# Superusuário definido na instalação do Postgres. Usado só pelo scripts/init_db.py
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
# Opcional: se definido, sobrescreve a conexão da aplicação montada acima
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/acompanhamento_semanal
SQL_ECHO=false

# --- API (FastAPI) ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Dashboard / formulários (Streamlit) ---
DASHBOARD_PORT=8501
# URL que o dashboard usa para falar com a API
API_BASE_URL=http://127.0.0.1:8000

# --- Regras de negócio do motor de cálculo ---
# Dias trabalhados na semana (divisor da produtividade média por equipe/dia)
DIAS_TRABALHADOS_SEMANA=5
# Dia em que a semana começa: 0=segunda ... 6=domingo
PRIMEIRO_DIA_SEMANA=0
# Índice de produtividade abaixo do qual a justificativa é obrigatória (0 desliga a regra)
INDICE_LIMITE_JUSTIFICATIVA=0.90
